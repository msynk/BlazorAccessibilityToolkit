<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <IsPackable>false</IsPackable>

    <Authors>Saleh Yusefnejad</Authors>
    <Copyright>Copyright (c) 2026 Saleh Yusefnejad</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/msynk/BlazorAccessibilityToolkit</PackageProjectUrl>
    <RepositoryUrl>https://github.com/msynk/BlazorAccessibilityToolkit</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>blazor;razor;accessibility;a11y;wcag;axe-core;testing;bunit;playwright</PackageTags>
    <VersionPrefix>0.1.0</VersionPrefix>
    <VersionSuffix>preview.1</VersionSuffix>
  </PropertyGroup>

  <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true' Or '$(TF_BUILD)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>
</Project>
