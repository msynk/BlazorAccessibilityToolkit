<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>false</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup Label="Runtime dependencies (pinned, upgrade deliberately; see docs/upgrading.md)">
    <!-- Deque.AxeCore.Playwright tracks axe-core major.minor: 4.14.x bundles axe-core 4.14. -->
    <PackageVersion Include="Deque.AxeCore.Playwright" Version="4.14.0" />
    <!-- The development overlay serves the axe-core script of Deque.AxeCore.Commons: keep the same version as above. -->
    <PackageVersion Include="Deque.AxeCore.Commons" Version="4.14.0" />
    <PackageVersion Include="Microsoft.Playwright" Version="1.64.1" />
    <!-- Native (UI Automation) audits of Blazor Hybrid apps on Windows: BlazorAccessibilityToolkit.Windows. -->
    <PackageVersion Include="Axe.Windows" Version="2.4.2" />
    <PackageVersion Include="bunit" Version="2.13.3" />
    <!-- The MCP server of the CLI tool (blazor-a11y mcp): the official C# SDK, without the hosting package. -->
    <PackageVersion Include="ModelContextProtocol.Core" Version="2.4.0" />
    <!-- The Razor analyzer targets Roslyn 4.8 so that it loads in every .NET 8 and later SDK. -->
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="4.8.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="4.8.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.Common" Version="4.8.0" />
  </ItemGroup>
  <ItemGroup Label="Test and demo dependencies">
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.0.1" />
    <PackageVersion Include="xunit.v3" Version="3.2.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.14" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.QuickGrid" Version="10.0.14" />
    <PackageVersion Include="NUnit" Version="4.6.1" />
    <PackageVersion Include="NUnit3TestAdapter" Version="6.2.0" />
    <PackageVersion Include="MSTest" Version="4.5.1" />
    <!-- The Blazor Hybrid test app (tests/Hybrid): BlazorWebView for Windows Forms, .NET 10 line. -->
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebView.WindowsForms" Version="10.0.120" />
  </ItemGroup>
</Project>
