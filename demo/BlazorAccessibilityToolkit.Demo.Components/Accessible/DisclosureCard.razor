@* A disclosure: a real button with aria-expanded and aria-controls that stay in sync with the content.
   Fixed version of ClickableCard (not keyboard operable) and StaleDisclosure (aria-expanded never changes). *@
<div class="card">
    <h3>
        <button type="button" class="disclosure" aria-expanded="@(expanded ? "true" : "false")" aria-controls="@panelId" @onclick="Toggle">@Title</button>
    </h3>
    <div id="@panelId" hidden="@(!expanded)">
        <p>@Details</p>
    </div>
</div>

@code {
    private readonly string panelId = $"card-panel-{Guid.NewGuid():N}";
    private bool expanded;

    [Parameter] public string Title { get; set; } = "Card";

    [Parameter] public string Details { get; set; } = string.Empty;

    private void Toggle() => expanded = !expanded;
}
