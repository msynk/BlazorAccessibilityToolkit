@implements IAsyncDisposable
@inject IJSRuntime JS
@* Modal dialog: moves focus into the dialog, keeps it there, closes with Escape and returns focus to the trigger. *@
<button type="button" class="secondary" @ref="trigger" aria-haspopup="dialog" aria-expanded="@(open ? "true" : "false")" @onclick="Open">@TriggerText</button>

@if (open)
{
    <div class="dialog-backdrop">
        @* tabindex="-1": focus can rest on the dialog itself when it has no focusable content or its text is clicked. *@
        <div @ref="dialog" class="dialog" role="dialog" aria-modal="true" tabindex="-1" aria-labelledby="@titleId"
             aria-describedby="@(ChildContent is null ? null : descriptionId)" @onkeydown="OnKeyDown">
            <h2 id="@titleId">@Title</h2>
            @if (ChildContent is not null)
            {
                <div id="@descriptionId">@ChildContent</div>
            }
            <div class="dialog-actions">
                <button type="button" class="secondary" @onclick="Close">@CancelText</button>
                <button type="button" class="primary" @onclick="ConfirmAsync">@ConfirmText</button>
            </div>
        </div>
    </div>
}

@code {
    private readonly string titleId = $"dialog-title-{Guid.NewGuid():N}";
    private readonly string descriptionId = $"dialog-description-{Guid.NewGuid():N}";
    private ElementReference trigger;
    private ElementReference dialog;
    private IJSObjectReference? module;
    private bool open;
    private bool activate;
    private bool restore;

    [Parameter] public string TriggerText { get; set; } = "Open dialog";

    [Parameter] public string Title { get; set; } = "Dialog";

    [Parameter] public string CancelText { get; set; } = "Cancel";

    [Parameter] public string ConfirmText { get; set; } = "OK";

    /// <summary>Dialog content. It also becomes the dialog's accessible description.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    [Parameter] public EventCallback OnConfirm { get; set; }

    private void Open()
    {
        if (open)
        {
            return;
        }

        open = true;
        activate = true;
    }

    private void Close()
    {
        if (!open)
        {
            return;
        }

        open = false;
        activate = false;
        restore = true;
    }

    private async Task ConfirmAsync()
    {
        Close();
        await OnConfirm.InvokeAsync();
    }

    private void OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            Close();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (activate)
        {
            activate = false;
            module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./_content/BlazorAccessibilityToolkit.Demo.Components/ModalDialog.razor.js");
            await module.InvokeVoidAsync("activate", dialog);
        }

        if (restore)
        {
            restore = false;
            if (module is not null)
            {
                await module.InvokeVoidAsync("deactivate");
            }

            await trigger.FocusAsync();
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (module is null)
        {
            return;
        }

        try
        {
            if (open)
            {
                await module.InvokeVoidAsync("deactivate");
            }

            await module.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
            // The circuit is gone, and the page with it: nothing to clean up.
        }
    }
}
