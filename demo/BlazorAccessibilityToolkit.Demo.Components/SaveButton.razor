@* Asynchronous operation with a status message in a live region that exists before the update. *@
<div class="save">
    <button type="button" class="primary" aria-disabled="@(saving ? "true" : "false")" @onclick="SaveAsync">@Text</button>
    <p role="status" class="status">@status</p>
</div>

@code {
    private bool saving;
    private string status = string.Empty;

    [Parameter] public string Text { get; set; } = "Save changes";

    /// <summary>The save operation. Without one, saving is simulated.</summary>
    [Parameter] public Func<Task>? OnSave { get; set; }

    private async Task SaveAsync()
    {
        // aria-disabled keeps the button focusable while saving, so ignore activations here instead.
        if (saving)
        {
            return;
        }

        saving = true;
        status = "Saving…";
        try
        {
            // Render "Saving…" even when the operation completes synchronously. Otherwise a repeated result ("Changes
            // saved" twice) would leave the live region unchanged, and screen readers would not announce it again.
            await Task.Yield();
            await (OnSave?.Invoke() ?? Task.Delay(150));
            status = "Changes saved";
        }
        catch (Exception)
        {
            // Report the failure where the progress was reported instead of leaving "Saving…" (and a disabled button) behind.
            status = "Changes could not be saved. Try again.";
        }
        finally
        {
            saving = false;
        }
    }
}
