<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Analyzers run inside the compiler, which loads netstandard2.0 assemblies. -->
    <TargetFramework>netstandard2.0</TargetFramework>
    <Description>Compile-time accessibility checks for Razor components: reports clickable elements without keyboard support, images without alt text, unlabeled form fields, unnamed buttons and links, invalid ARIA and other common defects in .razor files as build warnings, before any test runs.</Description>
    <RootNamespace>BlazorAccessibilityToolkit.Analyzers</RootNamespace>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <DevelopmentDependency>true</DevelopmentDependency>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <IncludeSymbols>false</IncludeSymbols>
    <NoWarn>$(NoWarn);NU5128;RS2008</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <!-- The blazor-a11y fix command runs the rules and fixes outside the compiler. -->
    <InternalsVisibleTo Include="BlazorAccessibilityToolkit.Cli" />
  </ItemGroup>
  <ItemGroup>
    <!-- Built first so that its assembly can be packed next to the analyzer; not referenced by the analyzer. -->
    <ProjectReference Include="..\BlazorAccessibilityToolkit.Analyzers.CodeFixes\BlazorAccessibilityToolkit.Analyzers.CodeFixes.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <None Include="$(OutputPath)$(AssemblyName).dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
  </ItemGroup>
  <!-- Packs the code fix assembly next to the analyzer, taking its path from the project instead of guessing the output folder. -->
  <Target Name="PackCodeFixes" BeforeTargets="_GetPackageFiles">
    <MSBuild Projects="..\BlazorAccessibilityToolkit.Analyzers.CodeFixes\BlazorAccessibilityToolkit.Analyzers.CodeFixes.csproj" Targets="GetTargetPath">
      <Output TaskParameter="TargetOutputs" ItemName="_CodeFixesAssembly" />
    </MSBuild>
    <Error Condition="!Exists('@(_CodeFixesAssembly)')" Text="The code fix assembly '@(_CodeFixesAssembly)' has not been built." />
    <ItemGroup>
      <None Include="@(_CodeFixesAssembly)" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
    </ItemGroup>
  </Target>
</Project>
