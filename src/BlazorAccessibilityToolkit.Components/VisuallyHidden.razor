@namespace BlazorAccessibilityToolkit.Components
@* Content for assistive technologies only: hidden visually, still read by screen readers (unlike display: none). *@
<span style="@Style" @attributes="AdditionalAttributes">@ChildContent</span>

@code {
    /// <summary>The CSS that hides content visually but keeps it in the accessibility tree.</summary>
    public const string Style = "position:absolute!important;width:1px!important;height:1px!important;padding:0!important;margin:-1px!important;overflow:hidden!important;clip:rect(0,0,0,0)!important;clip-path:inset(50%)!important;white-space:nowrap!important;border:0!important";

    /// <summary>The text or markup for assistive technologies.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Other attributes for the span (id, lang ...).</summary>
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }
}
