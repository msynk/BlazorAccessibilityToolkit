@attribute [StreamRendering]
@* Streams its content after a delay. Accessible: the region is aria-busy while loading and a status announces progress
   and completion. Otherwise it shows a bare "Loading…" placeholder. *@
<main>
    <h1>Orders</h1>
    @if (CartStatus is not null)
    {
        <p role="status">@CartStatus</p>
    }
    @if (Accessible)
    {
        <p role="status">@(orders is null ? "Loading orders…" : $"{orders.Length} orders loaded")</p>
    }
    <div aria-busy="@(Accessible && orders is null ? "true" : null)" id="orders">
        @if (orders is null)
        {
            <p>Loading…</p>
        }
        else
        {
            <ul aria-label="Orders">
                @foreach (var order in orders)
                {
                    <li>@order</li>
                }
            </ul>
        }
    </div>
</main>
@code {
    private string[]? orders;

    [Parameter] public bool Accessible { get; set; }

    /// <summary>An unrelated status message that is there before, during and after loading.</summary>
    [Parameter] public string? CartStatus { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await Task.Delay(1200);
        orders = ["Order 1", "Order 2", "Order 3"];
    }
}
