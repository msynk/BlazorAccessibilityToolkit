<Project Sdk="Microsoft.NET.Sdk">
  <!-- Starts the Blazor Hybrid test app and audits it through WebView2. The tests run on Windows and are skipped elsewhere. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\..\src\BlazorAccessibilityToolkit.Playwright\BlazorAccessibilityToolkit.Playwright.csproj" />
    <ProjectReference Include="..\..\..\src\BlazorAccessibilityToolkit.Windows\BlazorAccessibilityToolkit.Windows.csproj" />
    <!-- Built first, not referenced: the tests start its executable. -->
    <ProjectReference Include="..\BlazorAccessibilityToolkit.HybridTestApp\BlazorAccessibilityToolkit.HybridTestApp.csproj" ReferenceOutputAssembly="false" SkipGetTargetFrameworkProperties="true" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
</Project>
