@* The app's only page. It has one deliberate defect, an image without alt text, so the tests can see a finding. *@
<main>
    <h1>Orders</h1>
    <img id="logo" src="logo.png" width="32" height="32" />

    <p role="status">@(count == 0 ? "No orders yet." : $"{count} orders")</p>
    <button type="button" @onclick="() => count++">Add order</button>

    <label for="customer">Customer</label>
    <input id="customer" @bind="customer" />
</main>

@code {
    private int count;
    private string customer = string.Empty;
}
